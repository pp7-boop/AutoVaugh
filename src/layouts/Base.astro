---
const { title = 'Swanky Network', description = 'Elite companion experiences', canonical = '/' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <style>
    :root { color-scheme: light; font-family: 'Poppins', system-ui, -apple-system, sans-serif; }
    body { margin:0; background:#0c0c0f; color:#f8f8f8; }
    a { color:#9ad4ff; text-decoration:none; }
    header,footer { padding:24px; max-width:1100px; margin:0 auto; }
    main { max-width: 1100px; margin: 0 auto; padding: 16px 24px 48px; }
  </style>
</head>
<body>
  <header>
    <a href="/">Swanky Network</a>
  </header>
  <main>
    <slot />
  </main>
  <footer>© {new Date().getFullYear()} Swanky Network</footer>
</body>
</html>
