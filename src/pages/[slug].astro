---
import Base from "../layouts/Base.astro";
import ArticlePage from "../components/ArticlePage";
const { slug } = Astro.params;
export const prerender = false;
const API_BASE = Astro.env.PUBLIC_API_BASE ?? "https://api.vaughnsterling.com";
const res = await fetch(`${API_BASE}/article/${slug}`);
if (!res.ok) {
  throw Astro.redirect('/');
}
const article = await res.json();
---
<Base title={article.title} description={article.meta_description} canonical={`/${slug}`}>
  <ArticlePage article={article} />
</Base>
