---
import Base from "../layouts/Base.astro";
import ArticlePage from "../components/ArticlePage";
const { slug } = Astro.params;
export const prerender = false;
const defaultApi = "https://api.vaughnsterling.com";
const API_BASE = Astro.env.PUBLIC_API_BASE ?? Astro.env.PUBLIC_PREVIEW_API_BASE ?? defaultApi;
const res = await fetch(`${API_BASE}/article/${slug}`);
if (!res.ok) {
  throw Astro.redirect('/');
}
const article = await res.json();
let related = [];
try {
  const r = await fetch(`${API_BASE}/related/${slug}`);
  if (r.ok) {
    const json = await r.json();
    related = json.related ?? [];
  }
} catch (e) {
  related = [];
}
---
<Base title={article.title} description={article.meta_description} canonical={`/${slug}`}>
  <ArticlePage article={article} related={related} />
</Base>
