{
  "name": "autoblog",
  "main": "src/workers/worker.ts",
  "compatibility_date": "2024-11-01",
  "account_id": "22f8a8390779ed8d3951cab297d2b32a",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autoblog-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    },
    {
      "binding": "CONFIG_KV",
      "id": "REPLACE_WITH_CONFIG_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "autoblog-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONTENT_QUEUE",
        "queue": "content-queue"
      },
      {
        "binding": "IMAGE_QUEUE",
        "queue": "image-queue"
      }
    ],
    "consumers": [
      {
        "queue": "content-queue"
      },
      {
        "queue": "image-queue"
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "build": {
    "command": "npm run build",
    "cwd": "."
  },
  "routes": [
    {
      "pattern": "api.vaughnsterling.com/*",
      "custom_domain": true
    },
    {
      "pattern": "api.vaughnsterlingtours.com/*",
      "custom_domain": true
    },
    {
      "pattern": "api.swankyboyz.com/*",
      "custom_domain": true
    }
  ],
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "prod"
      }
    }
  }
}